<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/menu.css">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>
            <Button fx:id="backButton" onAction="#handleBack" text="← Back" styleClass="secondary-button"/>
            <Label text="Achievements" styleClass="title-label">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>

            <!-- Search Section -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Search by Title:">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <TextField fx:id="searchField" promptText="Enter achievement title..." prefWidth="250"/>
                <Button fx:id="searchButton" onAction="#handleSearch" text="Search" styleClass="secondary-button"/>
                <Button fx:id="clearSearchButton" onAction="#handleClearSearch" text="Clear" styleClass="secondary-button"/>
            </HBox>

            <!-- Achievement Table -->
            <TableView fx:id="achievementTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="250"/>
                    <TableColumn fx:id="conditionColumn" text="Condition" prefWidth="200"/>
                    <TableColumn fx:id="earnedAtColumn" text="Earned At" prefWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
