<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="overlayRoot"
      fx:controller="ua.notion.presentation.controller.SeedPlantingModalController"
      styleClass="seed-picker-overlay"
      pickOnBounds="false">

    <HBox fx:id="pickerBar" styleClass="seed-picker-bar" spacing="6" alignment="CENTER" visible="false" managed="false"/>

    <VBox fx:id="emptyState" styleClass="seed-picker-empty" alignment="CENTER" spacing="4"
          visible="false" managed="false">
        <Label text="No seeds" styleClass="seed-picker-empty-title"/>
        <Label text="Buy seeds at the shop" styleClass="seed-picker-empty-sub"/>
    </VBox>

</Pane>
