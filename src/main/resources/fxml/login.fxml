<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="root-container screen-root" alignment="CENTER">

    <Region styleClass="background-decoration" maxWidth="Infinity" maxHeight="Infinity"
            StackPane.alignment="CENTER"/>

    <VBox alignment="CENTER" spacing="0" styleClass="main-content" maxWidth="520" fillWidth="true">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <StackPane styleClass="logo-container" prefHeight="100" prefWidth="100">
            <Circle radius="50" styleClass="logo-circle"/>
            <Label text="🌱" styleClass="logo-icon">
                <font>
                    <Font size="40"/>
                </font>
            </Label>
        </StackPane>

        <Region prefHeight="20"/>

        <Label text="Garden Simulator" styleClass="main-title">
            <font>
                <Font name="Georgia Bold" size="32"/>
            </font>
        </Label>

        <Region prefHeight="8"/>

        <Label text="Cultivate your digital paradise" styleClass="subtitle" wrapText="true"
               textAlignment="CENTER"/>

        <Region prefHeight="28"/>

        <VBox spacing="20" styleClass="form-card" maxWidth="Infinity" minWidth="300">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="8">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="errorLabel" text="Error message" styleClass="error-label"
                   visible="false" wrapText="true" maxWidth="Infinity"/>

            <Button fx:id="loginButton" text="Sign In" styleClass="primary-button" prefHeight="48"
                    maxWidth="Infinity"/>

            <Separator styleClass="form-separator"/>

            <VBox spacing="10" alignment="CENTER" styleClass="register-prompt" maxWidth="Infinity">
                <Label text="New to Garden Simulator?" styleClass="prompt-text" wrapText="true"
                       textAlignment="CENTER" maxWidth="Infinity"/>
                <Button fx:id="registerButton" text="Create Account" styleClass="secondary-button"
                        maxWidth="Infinity" prefHeight="44" minHeight="44"/>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
