<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/menu.css">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>
            <Button fx:id="backButton" onAction="#handleBack" text="← Back" styleClass="secondary-button"/>
            <Label text="Task Management" styleClass="title-label">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>

            <!-- Filter Section -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Filter by Status:">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <ComboBox fx:id="statusFilterCombo" promptText="All Tasks" prefWidth="150"/>

                <Label text="Due Date:">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <DatePicker fx:id="dueDatePicker" promptText="Select date" prefWidth="150"/>

                <Button fx:id="clearFilterButton" onAction="#handleClearFilter" text="Clear Filters" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addTaskButton" onAction="#handleAddTask" text="+ New Task" styleClass="primary-button"/>
            </HBox>

            <!-- Task Table -->
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="taskTypeColumn" text="Task Type" prefWidth="150"/>
                    <TableColumn fx:id="plantInstanceColumn" text="Plant Instance ID" prefWidth="130"/>
                    <TableColumn fx:id="dueAtColumn" text="Due Date" prefWidth="180"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
