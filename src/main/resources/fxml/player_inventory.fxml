<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="overlayRoot"
            fx:controller="ua.notion.presentation.controller.PlayerInventoryController"
            styleClass="inventory-overlay"
            pickOnBounds="false">

    <VBox fx:id="inventoryPanel"
          styleClass="inventory-panel"
          spacing="8"
          AnchorPane.rightAnchor="12"
          AnchorPane.bottomAnchor="12">
        <HBox styleClass="inventory-header" alignment="CENTER_LEFT" spacing="8">
            <Label text="Bag" styleClass="inventory-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" styleClass="inventory-total"/>
            <Button text="×" styleClass="inventory-close" onAction="#close"/>
        </HBox>

        <ScrollPane fx:id="itemsScroll"
                    styleClass="inventory-scroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true">
            <content>
                <FlowPane fx:id="itemsFlow" styleClass="inventory-flow" hgap="6" vgap="6"/>
            </content>
        </ScrollPane>

        <VBox fx:id="emptyState" styleClass="inventory-empty" alignment="CENTER" spacing="4"
              visible="false" managed="false">
            <Label text="Empty" styleClass="inventory-empty-title"/>
            <Label text="Harvest ripe crops to fill your bag" styleClass="inventory-empty-sub"/>
        </VBox>
    </VBox>

</AnchorPane>
