<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="root-container screen-root" alignment="CENTER">

    <Region styleClass="background-decoration" maxWidth="Infinity" maxHeight="Infinity"
            StackPane.alignment="CENTER"/>

    <VBox alignment="CENTER" spacing="0" styleClass="main-content" maxWidth="520" fillWidth="true">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <StackPane styleClass="logo-container" prefHeight="100" prefWidth="100">
            <Circle radius="50" styleClass="logo-circle"/>
            <Label text="🌱" styleClass="logo-icon">
                <font>
                    <Font size="40"/>
                </font>
            </Label>
        </StackPane>

        <Region prefHeight="20"/>

        <Label text="Join Garden Simulator" styleClass="main-title" wrapText="true"
               textAlignment="CENTER" maxWidth="Infinity"/>

        <Region prefHeight="8"/>

        <Label text="Create your account and start growing" styleClass="subtitle" wrapText="true"
               textAlignment="CENTER" maxWidth="Infinity"/>

        <Region prefHeight="24"/>

        <VBox spacing="20" styleClass="form-card" maxWidth="Infinity" minWidth="300">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="8">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Choose a username"
                           styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="your.email@example.com"
                           styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Create a password"
                               styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password"
                               styleClass="custom-text-field" prefHeight="44" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Requirements:" styleClass="requirements-title"/>
                <Label text="• Username: 3–50 characters (letters, numbers, _)" styleClass="requirements-item" wrapText="true"/>
                <Label text="• Password: at least 8 characters" styleClass="requirements-item" wrapText="true"/>
                <Label text="• Valid email format" styleClass="requirements-item" wrapText="true"/>
            </VBox>

            <Label fx:id="errorLabel" text="Error message" styleClass="error-label"
                   visible="false" wrapText="true" maxWidth="Infinity"/>

            <Button fx:id="registerButton" text="Create Account" styleClass="primary-button"
                    prefHeight="48" maxWidth="Infinity"/>

            <Separator styleClass="form-separator"/>

            <VBox spacing="10" alignment="CENTER" styleClass="register-prompt" maxWidth="Infinity">
                <Label text="Already have an account?" styleClass="prompt-text" wrapText="true"
                       textAlignment="CENTER" maxWidth="Infinity"/>
                <Button fx:id="backToLoginButton" text="Back to Sign In" styleClass="secondary-button"
                        maxWidth="Infinity" prefHeight="44" minHeight="44"/>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
