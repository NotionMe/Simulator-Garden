<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="root-container">

    <!-- Background decorative elements -->
    <VBox styleClass="background-decoration" StackPane.alignment="TOP_LEFT"/>

    <!-- Main content -->
    <VBox alignment="CENTER" spacing="0" maxWidth="480" styleClass="main-content">
        <padding>
            <Insets top="40" right="60" bottom="40" left="60"/>
        </padding>

        <!-- Logo/Icon area with decorative circle -->
        <StackPane styleClass="logo-container" prefHeight="100" prefWidth="100">
            <Circle radius="50" styleClass="logo-circle"/>
            <Label text="🌱" styleClass="logo-icon">
                <font>
                    <Font size="40"/>
                </font>
            </Label>
        </StackPane>

        <Region prefHeight="24"/>

        <!-- Title -->
        <Label text="Join Garden Simulator" styleClass="main-title">
            <font>
                <Font name="Georgia Bold" size="32"/>
            </font>
        </Label>

        <Region prefHeight="8"/>

        <Label text="Create your account and start growing" styleClass="subtitle">
            <font>
                <Font name="Georgia" size="14"/>
            </font>
        </Label>

        <Region prefHeight="32"/>

        <!-- Registration Form Card -->
        <VBox spacing="20" styleClass="form-card">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <VBox spacing="6">
                <Label text="Username" styleClass="field-label">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Label>
                <TextField fx:id="usernameField" promptText="Choose a username"
                           styleClass="custom-text-field" prefHeight="44"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Email" styleClass="field-label">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Label>
                <TextField fx:id="emailField" promptText="your.email@example.com"
                           styleClass="custom-text-field" prefHeight="44"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" promptText="Create a password"
                               styleClass="custom-text-field" prefHeight="44"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Confirm Password" styleClass="field-label">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Label>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password"
                               styleClass="custom-text-field" prefHeight="44"/>
            </VBox>

            <VBox spacing="4" style="-fx-padding: 8 0 0 0;">
                <Label text="Requirements:" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #558b2f;"/>
                <Label text="• Username: 3-50 characters, alphanumeric + underscore" style="-fx-font-size: 9px; -fx-text-fill: #7cb342;"/>
                <Label text="• Password: minimum 8 characters" style="-fx-font-size: 9px; -fx-text-fill: #7cb342;"/>
                <Label text="• Valid email format" style="-fx-font-size: 9px; -fx-text-fill: #7cb342;"/>
            </VBox>

            <Label fx:id="errorLabel" text="Error message" styleClass="error-label"
                   visible="false" wrapText="true"/>

            <Region prefHeight="4"/>

            <Button fx:id="registerButton" text="Create Account" styleClass="primary-button"
                    prefHeight="48">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>

            <Separator styleClass="form-separator"/>

            <HBox spacing="8" alignment="CENTER" styleClass="register-prompt">
                <Label text="Already have an account?" styleClass="prompt-text">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <Button fx:id="backToLoginButton" text="Sign In" styleClass="link-button">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Button>
            </HBox>
        </VBox>

        <Region prefHeight="20"/>

        <!-- Footer -->
        <Label text="© 2026 Garden Simulator" styleClass="footer-text">
            <font>
                <Font size="11"/>
            </font>
        </Label>
    </VBox>
</StackPane>
